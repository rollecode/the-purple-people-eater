{
  "$schema": "https://schemas.wp.org/wp/7.0/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1000px"
    },
    "color": {
      "custom": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "ink",
          "name": "Teksti",
          "color": "var(--ink, #211B27)"
        },
        {
          "slug": "ground",
          "name": "Pohja",
          "color": "var(--ground, #F7F6F9)"
        },
        {
          "slug": "surface",
          "name": "Pinta",
          "color": "var(--surface, #FFFFFF)"
        },
        {
          "slug": "tint",
          "name": "Laventelin häivä",
          "color": "var(--tint, #F2EDF7)"
        },
        {
          "slug": "lavender",
          "name": "Laventeli",
          "color": "var(--lavender, #D3C4E3)"
        },
        {
          "slug": "accent",
          "name": "Korostus",
          "color": "var(--accent, #573F74)"
        },
        {
          "slug": "deep",
          "name": "Syvä violetti",
          "color": "var(--deep, #503B68)"
        },
        {
          "slug": "muted",
          "name": "Himmeä",
          "color": "var(--muted, #4F4758)"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fluid": false,
      "dropCap": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Instrument Serif (otsikot)",
          "fontFamily": "'Instrument Serif', 'Times New Roman', serif",
          "fontFace": [
            {
              "fontFamily": "Instrument Serif",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./fonts/InstrumentSerif-latin.woff2"
              ]
            },
            {
              "fontFamily": "Instrument Serif",
              "fontStyle": "italic",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./fonts/InstrumentSerif-Italic-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Atkinson Hyperlegible Next (leipäteksti)",
          "fontFamily": "'Atkinson Hyperlegible Next', system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Atkinson Hyperlegible Next",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./fonts/AtkinsonHyperlegibleNext-latin.woff2"
              ]
            },
            {
              "fontFamily": "Atkinson Hyperlegible Next",
              "fontStyle": "italic",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./fonts/AtkinsonHyperlegibleNext-Italic-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "sans",
          "name": "Geist (pieni teksti)",
          "fontFamily": "'Geist', system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Geist",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./fonts/Geist-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "logo",
          "name": "Inter (logo)",
          "fontFamily": "'Inter', system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontStyle": "normal",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "src": [
                "file:./fonts/Inter-Bold-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "monospace",
          "name": "Monospace",
          "fontFamily": "ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Pieni",
          "size": "16px"
        },
        {
          "slug": "default",
          "name": "Leipäteksti",
          "size": "20px"
        },
        {
          "slug": "large",
          "name": "Suuri",
          "size": "24px"
        },
        {
          "slug": "x-large",
          "name": "Väliotsikko",
          "size": "42px"
        },
        {
          "slug": "xx-large",
          "name": "Otsikko",
          "size": "64px"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ]
    }
  },
  "styles": {
    "color": {
      "text": "var:preset|color|ink",
      "background": "var:preset|color|ground"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|default",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|accent"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "400",
          "lineHeight": "1.1"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontWeight": "700"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontWeight": "700"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontWeight": "700"
        }
      },
      "caption": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "15px"
        }
      }
    },
    "css": ".editor-styles-wrapper { --ground: #F7F6F9; --surface: #FFFFFF; --tint: #F2EDF7; --soft: #EAE3F2; --lavender: #D3C4E3; --ink: #211B27; --ink-2: #3A3442; --muted: #4F4758; --rule: #E8E3ED; --rule-strong: #D1CAD8; --accent: #573F74; --deep: #503B68; --on-deep: #FFFFFF; --code-ground: #16121E; --display: 'Instrument Serif', serif; --body: 'Atkinson Hyperlegible Next', system-ui, sans-serif; --sans: 'Geist', system-ui, sans-serif; --mono: ui-monospace, Menlo, Consolas, monospace; }\n.editor-styles-wrapper a { text-decoration-thickness: 1px; text-underline-offset: .22em; }"
  }
}
