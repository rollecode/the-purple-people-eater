{
  "$schema": "https://schemas.wp.org/wp/7.0/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1000px"
    },
    "color": {
      "custom": true,
      "defaultPalette": true,
      "defaultGradients": true,
      "palette": [
        {
          "slug": "ink",
          "name": "Teksti",
          "color": "var(--ink, #211B27)"
        },
        {
          "slug": "ground",
          "name": "Pohja",
          "color": "var(--ground, #F7F6F9)"
        },
        {
          "slug": "surface",
          "name": "Pinta",
          "color": "var(--surface, #FFFFFF)"
        },
        {
          "slug": "tint",
          "name": "Laventelin häivä",
          "color": "var(--tint, #F2EDF7)"
        },
        {
          "slug": "lavender",
          "name": "Laventeli",
          "color": "var(--lavender, #D3C4E3)"
        },
        {
          "slug": "accent",
          "name": "Korostus",
          "color": "var(--accent, #573F74)"
        },
        {
          "slug": "deep",
          "name": "Syvä violetti",
          "color": "var(--deep, #503B68)"
        },
        {
          "slug": "muted",
          "name": "Himmeä",
          "color": "var(--muted, #4F4758)"
        }
      ],
      "customGradient": true,
      "customDuotone": true,
      "defaultDuotone": true,
      "link": true,
      "heading": true,
      "button": true,
      "caption": true,
      "background": true,
      "text": true
    },
    "typography": {
      "customFontSize": true,
      "fluid": false,
      "dropCap": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Instrument Serif (otsikot)",
          "fontFamily": "'Instrument Serif', 'Times New Roman', serif",
          "fontFace": [
            {
              "fontFamily": "Instrument Serif",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/InstrumentSerif-latin.woff2"
              ]
            },
            {
              "fontFamily": "Instrument Serif",
              "fontStyle": "italic",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/InstrumentSerif-Italic-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Atkinson Hyperlegible Next (leipäteksti)",
          "fontFamily": "'Atkinson Hyperlegible Next', system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Atkinson Hyperlegible Next",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/AtkinsonHyperlegibleNext-latin.woff2"
              ]
            },
            {
              "fontFamily": "Atkinson Hyperlegible Next",
              "fontStyle": "italic",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/AtkinsonHyperlegibleNext-Italic-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "sans",
          "name": "Geist (pieni teksti)",
          "fontFamily": "'Geist', system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Geist",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/Geist-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "logo",
          "name": "Inter (logo)",
          "fontFamily": "'Inter', system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontStyle": "normal",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/Inter-Bold-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "monospace",
          "name": "Monospace",
          "fontFamily": "ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Pieni",
          "size": "16px"
        },
        {
          "slug": "default",
          "name": "Leipäteksti",
          "size": "20px"
        },
        {
          "slug": "large",
          "name": "Suuri",
          "size": "24px"
        },
        {
          "slug": "x-large",
          "name": "Väliotsikko",
          "size": "42px"
        },
        {
          "slug": "xx-large",
          "name": "Otsikko",
          "size": "64px"
        }
      ],
      "defaultFontSizes": true
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw",
        "vmin",
        "vmax",
        "svh",
        "dvh",
        "ch"
      ],
      "margin": true,
      "padding": true,
      "blockGap": true,
      "customSpacingSize": true,
      "defaultSpacingSizes": true
    },
    "shadow": {
      "defaultPresets": true
    },
    "dimensions": {
      "defaultAspectRatios": true
    }
  },
  "styles": {
    "color": {
      "text": "var:preset|color|ink",
      "background": "var:preset|color|ground"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|default",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|accent"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "400",
          "lineHeight": "1.1"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontWeight": "700"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontWeight": "700"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontWeight": "700"
        }
      },
      "caption": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "15px"
        }
      }
    },
    "css": ".editor-styles-wrapper { color-scheme: dark; --wp--preset--color--ink: var(--ink); --wp--preset--color--ground: var(--ground); --wp--preset--color--surface: var(--surface); --wp--preset--color--tint: var(--tint); --wp--preset--color--lavender: var(--lavender); --wp--preset--color--accent: var(--accent); --wp--preset--color--deep: var(--deep); --wp--preset--color--muted: var(--muted); }\n.editor-styles-wrapper .site-head .bar > * { opacity: 1 !important; }\n.editor-styles-wrapper .article-head::before { opacity: 1; }\n.editor-styles-wrapper .wp-block-post-excerpt__more-link { display: none; }\n.editor-styles-wrapper :is(.meta-line, .meta, .cmt-actions) > .wp-block { margin-inline: 0; }\n",
    "spacing": {
      "blockGap": ""
    }
  },
  "customTemplates": [
    {
      "name": "page-archive",
      "title": "Arkisto",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-all",
      "title": "Kaikki kirjoitukset",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "template-no-title",
      "title": "Ei otsikkoa",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "template-info",
      "title": "Tietoa",
      "postTypes": [
        "page"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
